# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Secrets
.env
*.sqlite3
# Frontend
node_modules/
dist/
# IDE / OS
.DS_Store
Thumbs.db

# Local frontend API configuration
frontend/.env.local
frontend/.env.*.local

# User-created field boundaries (may contain sensitive coordinates)
backend/data/field_geometries.json
backend/data/*.tmp

# v1.0 persistent field catalog (includes custom field descriptions & geometries)
backend/data/fields.json

# Runtime-only port selected by START_AGRORADAR.bat
frontend/.agroradar-api-port

# Local auto-generated admin credentials (NEVER commit)
backend/data/admin_access.txt
# Local viewer accounts contain salted password hashes, NEVER commit
backend/data/viewer_accounts.json

# Final-suite local operational storage and backups
backend/data/*.sqlite3-*
backend/data/backups/
backend/data/*.bak
