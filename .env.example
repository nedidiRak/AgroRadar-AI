# AgroRadar AI local setup. This template contains no credentials.
# Copy weather/AI values into backend/.env. For Vite and the Wi-Fi launcher,
# put the Yandex key in frontend/.env.local. A prebuilt Mac .app uses ~/Library/Application Support/AgroRadar AI Expert/settings.env.

# OpenWeather: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Yandex Maps JavaScript API: https://developer.tech.yandex.ru/
# Public browser key; restrict allowed HTTP referrers in the Yandex console.
VITE_YANDEX_MAPS_API_KEY=

# Optional local settings
AGRORADAR_AUTO_MONITOR=0
AGRORADAR_MONITOR_BATCH=20
AGRORADAR_MONITOR_INTERVAL_SECONDS=90
AGRORADAR_WATER_CONTEXT=1
AGRORADAR_SECURE_COOKIES=0
# AGRORADAR_ADMIN_PASSWORD=  # leave unset to generate a local password file
