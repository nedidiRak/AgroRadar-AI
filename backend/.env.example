# OpenWeather: current conditions and 5-day/3-hour forecast
OPENWEATHER_API_KEY=

# DeepSeek: obtain from https://platform.deepseek.com/api_keys
# Keep this key ONLY in backend/.env (never in frontend/.env.local).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional: override auto-generated local admin password. Keep this in backend/.env ONLY.
# AGRORADAR_ADMIN_PASSWORD=your-long-private-password
# Set to 1 only behind HTTPS (secure cookies cannot be sent over HTTP).
AGRORADAR_SECURE_COOKIES=0
