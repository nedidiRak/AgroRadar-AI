# OpenWeather: current conditions and 5-day/3-hour forecast
OPENWEATHER_API_KEY=

# DeepSeek: obtain from https://platform.deepseek.com/api_keys
# Keep this key ONLY in backend/.env (never in frontend/.env.local).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional: override auto-generated local admin password. Keep this in backend/.env ONLY.
# AGRORADAR_ADMIN_PASSWORD=your-long-private-password
# Set to 1 only behind HTTPS (secure cookies cannot be sent over HTTP).
AGRORADAR_SECURE_COOKIES=0
# AgroRadar 4.0 · Дополнительный контекст влаги (учебный некоммерческий режим)
# 1 = запрос 7 прошедших суток Open-Meteo только для выбранного поля
# Для коммерческого применения необходима лицензия провайдера.
AGRORADAR_WATER_CONTEXT=1

# Опциональный плановый опрос OpenWeather, ТОЛЬКО пока запущен сервер.
# 0 = выключен (по умолчанию, исключает неожиданный расход API)
# 1 = включён; пакет по 20 участков, не чаще раза в 90 секунд.
AGRORADAR_AUTO_MONITOR=0
AGRORADAR_MONITOR_BATCH=20
AGRORADAR_MONITOR_INTERVAL_SECONDS=90
